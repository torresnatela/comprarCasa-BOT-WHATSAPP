# Copie para .env.local e ajuste os valores.

# Conexão com o PostgreSQL (o valor abaixo casa com o docker-compose.yml)
DATABASE_URL=postgres://comprarcasa:comprarcasa@localhost:5432/comprarcasa

# URL pública do portal, usada para montar o link de convite.
# Se ficar vazia, o sistema usa a origem da própria requisição.
APP_URL=http://localhost:3000

# Primeiro gestor, criado por `pnpm db:seed`
SEED_ADMIN_NAME=Gestor
SEED_ADMIN_EMAIL=gestor@exemplo.com
SEED_ADMIN_PASSWORD=troque-esta-senha
